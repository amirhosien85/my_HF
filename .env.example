# ---- Hugging Face (cognitive engine) ----
HF_TOKEN=hf_xxx
# Must be a model your HF account's enabled providers serve (see https://router.huggingface.co/v1/models).
HF_MODEL=meta-llama/Llama-3.3-70B-Instruct
HF_ROUTER_BASE=https://router.huggingface.co
HF_API_BASE=https://router.huggingface.co/v1
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_ASR_MODEL=openai/whisper-large-v3

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=123456:ABC
TELEGRAM_SUPERGROUP_ID=-1001234567890
TOPIC_AI=2
TOPIC_HACK=3
TOPIC_REDPILL=4

# ---- Cognitive microservice ----
COGNITIVE_BASE_URL=http://cognitive:8500
SERVICE_TOKEN=change-me
COLLISION_THRESHOLD=0.35

# ---- n8n ----
N8N_PORT=7860
N8N_LISTEN_ADDRESS=0.0.0.0
N8N_ENCRYPTION_KEY=change-me-32-chars-minimum
GENERIC_TIMEZONE=Asia/Tehran

# ---- Postgres (local compose defaults; on HF use the Supabase pooler) ----
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=n8n
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_SCHEMA=public
# Supabase requires SSL:
# DB_POSTGRESDB_SSL_ENABLED=true
# DB_POSTGRESDB_SSL_REJECT_UNAUTHORIZED=false
