{
  "name": "04 · Forum Publisher (topics, chunking, inline buttons)",
  "nodes": [
    {
      "parameters": { "rule": { "interval": [{ "field": "minutes", "minutesInterval": 5 }] } },
      "id": "d4000000-0000-4000-8000-000000000001",
      "name": "Every 5 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-940, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT url, short_id, title, category, article FROM news_items WHERE status = 'edited' ORDER BY published_at DESC NULLS LAST LIMIT 3;",
        "options": {}
      },
      "id": "d4000000-0000-4000-8000-000000000002",
      "name": "Fetch edited items",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [-720, 300],
      "credentials": {
        "postgres": { "id": "REPLACE_WITH_POSTGRES_CREDENTIAL_ID", "name": "Supabase Postgres" }
      }
    },
    {
      "parameters": { "batchSize": 1, "options": { "reset": false } },
      "id": "d4000000-0000-4000-8000-000000000003",
      "name": "Loop Over Items",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [-500, 300]
    },
    {
      "parameters": {
        "jsCode": "// Telegram hard limit is 4096 chars per message; split on paragraph boundaries.\nconst LIMIT = 3900; // headroom for HTML entities\nconst item = $json;\nconst topics = {\n  ai: $env.TOPIC_AI,\n  hack: $env.TOPIC_HACK,\n  redpill: $env.TOPIC_REDPILL\n};\nconst threadId = topics[item.category] || topics.ai;\n\nconst chunks = [];\nlet buffer = '';\nfor (const paragraph of String(item.article || '').split('\\n\\n')) {\n  const candidate = buffer ? `${buffer}\\n\\n${paragraph}` : paragraph;\n  if (candidate.length <= LIMIT) {\n    buffer = candidate;\n    continue;\n  }\n  if (buffer) chunks.push(buffer);\n  if (paragraph.length <= LIMIT) {\n    buffer = paragraph;\n  } else {\n    for (let i = 0; i < paragraph.length; i += LIMIT) chunks.push(paragraph.slice(i, i + LIMIT));\n    buffer = '';\n  }\n}\nif (buffer) chunks.push(buffer);\nif (chunks.length === 0) chunks.push(item.title);\n\nreturn chunks.map((text, index) => ({\n  json: {\n    url: item.url,\n    short_id: item.short_id,\n    category: item.category,\n    thread_id: threadId,\n    chunk_index: index,\n    is_last: index === chunks.length - 1,\n    text: chunks.length > 1 ? `${text}\\n\\n<i>(${index + 1}/${chunks.length})</i>` : text\n  }\n}));"
      },
      "id": "d4000000-0000-4000-8000-000000000004",
      "name": "Chunk to 4096 limit",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-280, 380]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify(Object.assign({ chat_id: $env.TELEGRAM_SUPERGROUP_ID, message_thread_id: Number($json.thread_id), text: $json.text, parse_mode: 'HTML', disable_web_page_preview: true }, $json.is_last ? { reply_markup: { inline_keyboard: [[ { text: '🔥 عالیه', callback_data: 'fire|' + $json.category + '|' + $json.short_id }, { text: '💤 رد کن', callback_data: 'pass|' + $json.category + '|' + $json.short_id } ], [ { text: '💊 قرص قرمز', callback_data: 'redpill|' + $json.category + '|' + $json.short_id } ]] } } : {})) }}",
        "options": { "timeout": 30000, "response": { "response": { "neverError": true } } }
      },
      "id": "d4000000-0000-4000-8000-000000000005",
      "name": "Telegram · sendMessage",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-60, 380]
    },
    {
      "parameters": { "amount": 2, "unit": "seconds" },
      "id": "d4000000-0000-4000-8000-000000000006",
      "name": "Flood-wait 2s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [160, 380],
      "webhookId": "c0000000-0000-4000-8000-0000000000bb"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "version": 2 },
          "combinator": "and",
          "conditions": [
            {
              "id": "is-last-chunk",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true },
              "leftValue": "={{ $('Chunk to 4096 limit').item.json.is_last }}"
            }
          ]
        },
        "options": {}
      },
      "id": "d4000000-0000-4000-8000-000000000007",
      "name": "Last chunk?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [380, 380]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE news_items SET status = 'published', telegram_msg_id = $2, updated_at = now() WHERE url = $1;",
        "options": {
          "queryReplacement": "={{ $('Chunk to 4096 limit').item.json.url }},={{ $('Telegram · sendMessage').item.json.result?.message_id || null }}"
        }
      },
      "id": "d4000000-0000-4000-8000-000000000008",
      "name": "Mark published",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [600, 300],
      "credentials": {
        "postgres": { "id": "REPLACE_WITH_POSTGRES_CREDENTIAL_ID", "name": "Supabase Postgres" }
      }
    },
    {
      "parameters": {},
      "id": "d4000000-0000-4000-8000-000000000009",
      "name": "Next chunk",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [600, 460]
    }
  ],
  "connections": {
    "Every 5 min": { "main": [[{ "node": "Fetch edited items", "type": "main", "index": 0 }]] },
    "Fetch edited items": { "main": [[{ "node": "Loop Over Items", "type": "main", "index": 0 }]] },
    "Loop Over Items": {
      "main": [[], [{ "node": "Chunk to 4096 limit", "type": "main", "index": 0 }]]
    },
    "Chunk to 4096 limit": {
      "main": [[{ "node": "Telegram · sendMessage", "type": "main", "index": 0 }]]
    },
    "Telegram · sendMessage": { "main": [[{ "node": "Flood-wait 2s", "type": "main", "index": 0 }]] },
    "Flood-wait 2s": { "main": [[{ "node": "Last chunk?", "type": "main", "index": 0 }]] },
    "Last chunk?": {
      "main": [
        [{ "node": "Mark published", "type": "main", "index": 0 }],
        [{ "node": "Next chunk", "type": "main", "index": 0 }]
      ]
    },
    "Mark published": { "main": [[{ "node": "Loop Over Items", "type": "main", "index": 0 }]] },
    "Next chunk": { "main": [[{ "node": "Loop Over Items", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1", "saveDataErrorExecution": "all" },
  "pinData": {},
  "tags": [{ "name": "telegram" }]
}
