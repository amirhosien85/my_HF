        "query": "SELECT url, title, summary FROM news_items WHERE short_id = $1;",
        "options": { "queryReplacement": "={{ $('Parse callback').item.json.short_id }}" }
      },
      "id": "e5000000-0000-4000-8000-000000000006",
      "name": "Load source item",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [140, 200],
      "credentials": {
        "postgres": { "id": "REPLACE_WITH_POSTGRES_CREDENTIAL_ID", "name": "Supabase Postgres" }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.COGNITIVE_BASE_URL }}/redpill",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "X-Service-Token", "value": "={{ $env.SERVICE_TOKEN }}" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ title: $json.title, summary: $json.summary, url: $json.url }) }}",
        "options": { "timeout": 240000 }
      },
      "id": "e5000000-0000-4000-8000-000000000007",
      "name": "Cognitive · deep dive (RAG)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [360, 200]
    },
    {
      "parameters": {
        "jsCode": "const LIMIT = 3900;\nconst source = $('Load source item').item.json;\nconst body = String($json.text || '').trim();\nconst header = `<b>💊 قرص قرمز: ${source.title}</b>\\n`;\nconst full = `${header}\\n${body}\\n\\n🔗 <a href=\"${source.url}\">منبع</a>`;\nconst chunks = [];\nfor (let i = 0; i < full.length; i += LIMIT) chunks.push(full.slice(i, i + LIMIT));\nreturn chunks.map((text, index) => ({ json: { text, chunk_index: index, total: chunks.length } }));"
      },
      "id": "e5000000-0000-4000-8000-000000000008",
      "name": "Chunk report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [580, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $env.TELEGRAM_SUPERGROUP_ID, message_thread_id: Number($env.TOPIC_REDPILL), text: $json.text, parse_mode: 'HTML', disable_web_page_preview: true }) }}",
        "options": { "timeout": 30000, "response": { "response": { "neverError": true } } }
      },
      "id": "e5000000-0000-4000-8000-000000000009",
