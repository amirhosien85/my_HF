{
  "name": "05 · Red Pill Deep Dive (RAG) + reaction sink",
  "nodes": [
    {
      "parameters": {
        "workflowInputs": {
          "values": [
            { "name": "callback_data" },
            { "name": "user_id" },
            { "name": "chat_id" },
            { "name": "callback_query_id" }
          ]
        }
      },
      "id": "e5000000-0000-4000-8000-000000000001",
      "name": "When called by 02",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [-960, 300]
    },
    {
      "parameters": {
        "jsCode": "// callback_data format: <action>|<category>|<short_id>\nreturn $input.all().map(item => {\n  const [action = '', category = 'ai', short_id = ''] = String(item.json.callback_data || '').split('|');\n  const toast = { fire: '🔥 ثبت شد، پشمام!', pass: '💤 باشه، کمترش می‌کنم', redpill: '💊 قرص قرمز خورده شد... صبر کن' }[action] || '✅';\n  return { json: { ...item.json, action, category, short_id, toast } };\n});"
      },
      "id": "e5000000-0000-4000-8000-000000000002",
      "name": "Parse callback",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-740, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/answerCallbackQuery",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ callback_query_id: $json.callback_query_id, text: $json.toast }) }}",
        "options": { "response": { "response": { "neverError": true } } }
      },
      "id": "e5000000-0000-4000-8000-000000000003",
      "name": "Telegram · answerCallbackQuery",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-520, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH target AS (\n  SELECT url FROM news_items WHERE short_id = $1\n), ins AS (\n  INSERT INTO reactions (url, category, user_id, action)\n  SELECT url, $2, $3::bigint, $4 FROM target\n  RETURNING category\n)\nINSERT INTO category_prefs (user_id, category, ignore_streak, updated_at)\nVALUES ($3::bigint, $2, CASE WHEN $4 = 'pass' THEN 1 ELSE 0 END, now())\nON CONFLICT (user_id, category) DO UPDATE\n  SET ignore_streak = CASE WHEN $4 = 'pass' THEN category_prefs.ignore_streak + 1 ELSE 0 END,\n      updated_at = now()\nRETURNING user_id, category, ignore_streak;",
        "options": {
          "queryReplacement": "={{ $('Parse callback').item.json.short_id }},={{ $('Parse callback').item.json.category }},={{ $('Parse callback').item.json.user_id }},={{ $('Parse callback').item.json.action }}"
        }
      },
      "id": "e5000000-0000-4000-8000-000000000004",
      "name": "Record reaction + streak",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [-300, 300],
      "credentials": {
        "postgres": { "id": "REPLACE_WITH_POSTGRES_CREDENTIAL_ID", "name": "Supabase Postgres" }
      }
    },
