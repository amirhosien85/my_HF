      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "version": 2 },
          "combinator": "and",
          "conditions": [
            {
              "id": "is-redpill",
              "operator": { "type": "string", "operation": "equals" },
              "leftValue": "={{ $('Parse callback').item.json.action }}",
              "rightValue": "redpill"
            }
          ]
        },
        "options": {}
      },
      "id": "e5000000-0000-4000-8000-000000000005",
      "name": "Red Pill?",
