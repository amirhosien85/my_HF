            "index": 0
          }
        ]
      ]
    },
    "Upsert telegram_updates (dedupe by update_id)": {
      "main": [
        [
          {
            "node": "Flood-wait 1s",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Flood-wait 1s": {
      "main": [
        [
          {
            "node": "Route by kind",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Route by kind": {
      "main": [
        [
          {
            "node": "Idea Collider · store text",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Idea Collider · transcribe voice",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Handle button press",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Manual test run": {
