{
  "name": "02 · Telegram Polling Engine (getUpdates, no webhooks)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "id": "b2000000-0000-4000-8000-000000000001",
      "name": "Every minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -940,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT offset_value FROM telegram_offset WHERE id = 1;",
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000002",
      "name": "Load offset",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        -740,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_WITH_POSTGRES_CREDENTIAL_ID",
          "name": "Supabase Postgres"
        }
      }
    },
    {
      "parameters": {
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/getUpdates",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "offset",
              "value": "={{ $json.offset_value }}"
            },
            {
              "name": "limit",
              "value": "50"
            },
            {
              "name": "timeout",
              "value": "0"
            },
            {
              "name": "allowed_updates",
              "value": "[\"message\",\"callback_query\"]"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          },
          "timeout": 20000
        }
      },
      "id": "b2000000-0000-4000-8000-000000000003",
      "name": "GET getUpdates",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -520,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "has-updates",
              "operator": {
                "type": "number",
                "operation": "gt"
              },
              "leftValue": "={{ ($json.result || []).length }}",
              "rightValue": 0
            }
          ]
        },
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000004",
      "name": "Any updates?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -300,
        300
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "result",
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000005",
      "name": "Split Out Items",
      "type": "n8n-nodes-base.itemLists",
      "typeVersion": 3,
      "position": [
        -80,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "// Flatten a Telegram update into a flat, typed row.\nconst out = [];\nfor (const item of $input.all()) {\n  const u = item.json;\n  const msg = u.message;\n  const cb = u.callback_query;\n  let kind = 'other';\n  let text = '';\n  let file_id = '';\n  let chat_id = null;\n  let user_id = null;\n  let message_id = null;\n  let callback_data = '';\n  let callback_query_id = '';\n\n  if (cb) {\n    kind = 'callback';\n    chat_id = cb.message?.chat?.id ?? null;\n    user_id = cb.from?.id ?? null;\n    message_id = cb.message?.message_id ?? null;\n    callback_data = cb.data || '';\n    callback_query_id = cb.id;\n  } else if (msg) {\n    chat_id = msg.chat?.id ?? null;\n    user_id = msg.from?.id ?? null;\n    message_id = msg.message_id ?? null;\n    if (msg.voice || msg.audio) {\n      kind = 'voice';\n      file_id = (msg.voice || msg.audio).file_id;\n    } else if (msg.text) {\n      kind = 'text';\n      text = msg.text;\n    }\n  }\n\n  out.push({ json: { update_id: u.update_id, kind, text, file_id, chat_id, user_id, message_id, callback_data, callback_query_id, payload: u } });\n}\nreturn out;"
      },
      "id": "b2000000-0000-4000-8000-000000000006",
      "name": "Classify update",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        140,
        200
      ]
    },
    {
      "parameters": {
        "operation": "upsert",
        "schema": {
          "__rl": true,
          "mode": "name",
          "value": "public"
        },
        "table": {
          "__rl": true,
          "mode": "name",
          "value": "telegram_updates"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "matchingColumns": [
            "update_id"
          ],
          "value": {
            "update_id": "={{ $json.update_id }}",
            "chat_id": "={{ $json.chat_id }}",
            "user_id": "={{ $json.user_id }}",
            "kind": "={{ $json.kind }}",
            "payload": "={{ JSON.stringify($json.payload) }}"
          }
        },
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000007",
      "name": "Upsert telegram_updates (dedupe by update_id)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        360,
        200
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_WITH_POSTGRES_CREDENTIAL_ID",
          "name": "Supabase Postgres"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "amount": 1,
        "unit": "seconds"
      },
      "id": "b2000000-0000-4000-8000-000000000008",
      "name": "Flood-wait 1s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        580,
        200
      ],
      "webhookId": "c0000000-0000-4000-8000-0000000000aa"
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "version": 2
                },
                "combinator": "and",
                "conditions": [
                  {
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "leftValue": "={{ $('Classify update').item.json.kind }}",
                    "rightValue": "text"
                  }
                ]
              },
              "outputKey": "text"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "version": 2
                },
                "combinator": "and",
                "conditions": [
                  {
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "leftValue": "={{ $('Classify update').item.json.kind }}",
                    "rightValue": "voice"
                  }
                ]
              },
              "outputKey": "voice"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "version": 2
                },
                "combinator": "and",
                "conditions": [
                  {
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "leftValue": "={{ $('Classify update').item.json.kind }}",
                    "rightValue": "callback"
                  }
                ]
              },
              "outputKey": "callback"
            }
          ]
        },
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000009",
      "name": "Route by kind",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        800,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.COGNITIVE_BASE_URL }}/ideas",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Service-Token",
              "value": "={{ $env.SERVICE_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $('Classify update').item.json.text, user_id: String($('Classify update').item.json.user_id), chat_id: String($('Classify update').item.json.chat_id), source: 'telegram_text' }) }}",
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-00000000000a",
      "name": "Idea Collider · store text",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1040,
        60
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.COGNITIVE_BASE_URL }}/voice",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Service-Token",
              "value": "={{ $env.SERVICE_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ file_id: $('Classify update').item.json.file_id, user_id: String($('Classify update').item.json.user_id), chat_id: String($('Classify update').item.json.chat_id) }) }}",
        "options": {
          "timeout": 180000
        }
      },
      "id": "b2000000-0000-4000-8000-00000000000b",
      "name": "Idea Collider · transcribe voice",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1040,
        220
      ]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "list",
          "value": "REPLACE_WITH_WORKFLOW_ID_OF_05",
          "cachedResultName": "05 · Red Pill Deep Dive (RAG)"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "callback_data": "={{ $('Classify update').item.json.callback_data }}",
            "user_id": "={{ $('Classify update').item.json.user_id }}",
            "chat_id": "={{ $('Classify update').item.json.chat_id }}",
            "callback_query_id": "={{ $('Classify update').item.json.callback_query_id }}"
          }
        },
        "options": {
          "waitForSubWorkflow": false
        }
      },
      "id": "b2000000-0000-4000-8000-00000000000c",
      "name": "Handle button press",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        1040,
        380
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE telegram_offset SET offset_value = $1, updated_at = now() WHERE id = 1;",
        "options": {
          "queryReplacement": "={{ Math.max(...$json.result.map(u => u.update_id)) + 1 }}"
        }
      },
      "id": "b2000000-0000-4000-8000-00000000000d",
      "name": "Advance offset",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        -80,
        440
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_WITH_POSTGRES_CREDENTIAL_ID",
          "name": "Supabase Postgres"
        }
      }
    },
    {
      "parameters": {},
      "id": "b2000000-0000-4000-8000-00000000000f",
      "name": "Manual test run",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -940,
        460
      ]
    }
  ],
  "connections": {
    "Every minute": {
      "main": [
        [
          {
            "node": "Load offset",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Load offset": {
      "main": [
        [
          {
            "node": "GET getUpdates",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GET getUpdates": {
      "main": [
        [
          {
            "node": "Any updates?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Any updates?": {
      "main": [
        [
          {
            "node": "Split Out Items",
